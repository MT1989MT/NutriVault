# NutriVault Environment Variables

# API Base URL (optional - defaults to https://nutri-vault.vercel.app)
# VITE_API_BASE_URL=http://localhost:3001

# Gemini API Key (required for server-side API route)
# GEMINI_API_KEY=your-gemini-api-key

# Supabase (optional - defaults to hardcoded values)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat (optional - defaults to test key)
# VITE_REVENUECAT_API_KEY=your-revenuecat-api-key
