# NutriVault Environment Variables
#
# VITE_ prefixed vars are available in the frontend (browser)
# Non-prefixed vars are server-side only (Vercel API routes)

# ── Frontend (VITE_) ──────────────────────────────────────

# API Base URL for Vercel API proxy routes
# Required in production; local dev uses relative paths
VITE_API_BASE_URL=https://nutri-vault-two.vercel.app

# Supabase project URL and anon key (required for activation codes)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat API key (optional - for in-app purchases)
# VITE_REVENUECAT_API_KEY=your-revenuecat-api-key

# Test mode: shows a "Free Access" button that bypasses payment and enables the
# free subscription-extend shortcut. FOR TESTING/PREVIEW ONLY — never set to
# "true" in a production build, it lets any visitor in for free.
# VITE_TEST_MODE=true

# ── Server-side only (Vercel env / Supabase secrets) ──────

# Gemini API Key (required for /api/gemini)
GEMINI_API_KEY=your-gemini-api-key

# Supabase server-side keys (required for /api/create-code, /api/extend-subscription)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Shared secret between Vercel API routes and Edge Functions
# Generate with: openssl rand -hex 32
# Must also be set in Supabase Edge Function secrets
EDGE_FUNCTION_SECRET=your-edge-function-secret

# RevenueCat Webhook Authorization Secret
# Set in RevenueCat Dashboard → Integrations → Webhooks → Authorization header
# Generate with: openssl rand -hex 32
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Extra CORS origins (comma-separated, for preview deployments)
# ALLOWED_ORIGINS=https://preview-123.vercel.app,https://staging.example.com

# Enable diagnostic endpoints (e.g. /api/debug-gemini). Leave unset in production.
# Set to "true" only on a temporary/preview deployment when debugging.
# ENABLE_DEBUG_ENDPOINTS=true
